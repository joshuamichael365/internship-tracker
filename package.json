{
  "name": "internship-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter web build && pnpm --filter worker build",
    "db:generate": "pnpm --filter @tracker/db generate",
    "db:migrate": "pnpm --filter @tracker/db migrate",
    "db:studio": "pnpm --filter @tracker/db studio"
  }
}
