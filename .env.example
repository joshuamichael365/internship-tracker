# --- Core ---
DATABASE_URL=postgres://localhost:5432/internship_tracker
# Directory where uploaded/generated files (resumes, cover letters) are stored
# on disk. Defaults to <repo>/data/uploads when unset; set to the Railway
# volume mount path (e.g. /data/uploads) in production.
UPLOAD_DIR=

# --- Auth (Google OAuth via console.cloud.google.com) ---
AUTH_SECRET=            # generate: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL=joshuamichael365@gmail.com
# Dev-only escape hatch while Google OAuth creds aren't set up yet.
# NEVER set this in production.
AUTH_DISABLED=false
# Canonical externally-reachable URL NextAuth should trust for callbacks —
# required when the app sits behind a proxy (Railway) so redirect URIs
# resolve correctly instead of to an internal hostname.
AUTH_URL=
# Public base URL of the deployed app (used to build absolute links, e.g. in
# notifications). Same value as AUTH_URL in most deployments.
APP_URL=

# --- AI drafting/tagging (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Notifications (filled in during M3/M6) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=joshuamichael365@gmail.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_SMS_TO=

# --- Browser extension (Agentic Assist / Full Auto-Apply) ---
# Bearer token the extension presents to /api/assist/*; deny-by-default when
# unset (every assist request 401s). Generate with: openssl rand -hex 32
EXTENSION_TOKEN=

# --- Document storage ---
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# --- Reserved for future features (not currently read) ---
# GITHUB_TOKEN would raise GitHub API rate limits for repo polling if wired up.
# The R2_* vars were planned as an alternate storage backend behind
# lib/storage.ts's interface but were superseded by the Railway volume mount
# (UPLOAD_DIR above) — no code currently reads them.
GITHUB_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=internship-docs
